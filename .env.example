# Template for the local .env — every variable the app reads, values blank.
# Copy to .env and fill them in. Real values never belong in this file.

# ─── Generation providers ────────────────────────────────────────────────────
FAL_KEY=
RUNWARE_KEY=
MIDJOURNEY_KEY=
MIDJOURNEY_TT_API_KEY_FALLBACK=

# ─── Text models (home-page model picker) ────────────────────────────────────
# Each key enables its models in GET /models. "Palette" uses the platform LLM
# service (ctx.llm) and needs no key here.
ANTHROPIC_API_KEY=
OPENAI_KEY=
GOOGLE_AI_API_KEY=

# ─── Voice-over + music ──────────────────────────────────────────────────────
ELEVEN_API_KEY=

# ─── Palette LLM router (optional, images) ───────────────────────────────────
LLM_ROUTER_ENABLED=
LLM_ROUTER_API_KEY=
LLM_ROUTER_BASE_URL=

# ─── Database ────────────────────────────────────────────────────────────────
# Do not set a plain `DATABASE_URL`: `pltt dev --sandbox`/publish uploads every
# undeclared uppercase key from this file as a staging secret. PALETTE_* keys
# are reserved and never uploaded.
# PALETTE_DEV_DATABASE_URL=postgresql+asyncpg://palette_user:palette_user_password@localhost:5455/pltt_video_studio_2
PALETTE_DEV_DATABASE_URL=
